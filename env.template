## Copy this file to .env.local and fill values.
## (Do NOT commit .env.local)

## MongoDB
MONGODB_URI=
## Optional (only if your URI does not include a default DB)
MONGODB_DB=

## Admin auth
ADMIN_PASSWORD=
## Any long random string
ADMIN_SESSION_SECRET=

## Email (Resend)
RESEND_API_KEY=
## Example: "Fasea Booking <booking@yourdomain.com>"
EMAIL_FROM=

## Twilio WhatsApp (for auto-cancel + booking notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
## Twilio sandbox/number in E.164, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
## Studio/admin WhatsApp number in E.164, e.g. +60123456789
TWILIO_WHATSAPP_TO=
## Optional: base URL override for testing
TWILIO_API_BASE_URL=

## Job secret (optional). If set, call the job endpoint with header x-job-secret or ?secret=...
AUTO_CANCEL_JOB_SECRET=

## Firebase Cloud Messaging (app push notifications)
## Firebase Console → Project settings → Service accounts → Generate new private key
## Paste the full JSON on one line (or minified) into .env.local / Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

## Flutter web app origins (production). Comma-separated, e.g. https://app.fasea.studio
FASEA_FLUTTER_WEB_ORIGINS=

## Used for BOTH:
## - /api/admin/jobs/auto-cancel
## - /api/admin/jobs/reminders


## Google OAuth (web + app Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## Apple Sign-In (web)
## APPLE_TEAM_ID = Apple Developer Team ID (e.g. YA5WWQMDDP) — NOT the App ID / bundle ID
## APPLE_CLIENT_ID = Services ID for web (e.g. com.fasea.fasea.web)
## APPLE_KEY_ID = Sign in with Apple key ID
## APPLE_PRIVATE_KEY = .p8 private key contents (use \n for newlines in .env)
APPLE_TEAM_ID=YA5WWQMDDP
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

## Twilio Content SIDs (WhatsApp templates, required outside the 24-hour window)
## Fill these after your templates are approved in Twilio.
TWILIO_CONTENT_SID_BOOKING_CONFIRMED_EN=
TWILIO_CONTENT_SID_BOOKING_REMINDER_EN=
TWILIO_CONTENT_SID_BOOKING_CANCELLED_BY_CLIENT_EN=
TWILIO_CONTENT_SID_CLASS_CANCELLED_BY_INSTRUCTOR_EN=
TWILIO_CONTENT_SID_NO_SHOW_FIRST_TIMER_EN=
TWILIO_CONTENT_SID_NO_SHOW_EN=
